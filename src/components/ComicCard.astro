---
import type { ComicEntry } from "../lib/comics";
import { parseChapters } from "../lib/comics";

interface Props {
  comic: ComicEntry;
}

const { comic } = Astro.props;
const { title, cover, tags } = comic.data;
const slug = comic.slug;
const chapterCount = parseChapters(comic).length;
---

<a class="comic-card" href={`/comic/${slug}`} aria-label={`${title}，${chapterCount} 章`}>
  <div class="comic-card-cover">
    <img
      src={cover}
      alt={title}
      loading="lazy"
      decoding="async"
      width="600"
      height="900"
      onerror="this.onerror=null;this.src='/default-cover.webp';"
    />
    <span class="comic-card-chapter-count">{chapterCount} 章</span>
  </div>
  <div class="comic-card-body">
    <h2 class="comic-card-title">{title}</h2>
    <div class="comic-card-tags">
      {tags.map((tag) => (
        <span>{tag}</span>
      ))}
    </div>
  </div>
  <span class="card-go">
    开始阅读
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  </span>
</a>
