---
import "@fontsource-variable/noto-serif-sc";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { siteConfig } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}

const {
  title = siteConfig.title,
  description = "星之轨（Tsukipool）· 月色真美，风也温柔。在线漫画阅读网站：精选漫画合集，章节连载更新，支持标签筛选与全文搜索。",
  hideFooter = false,
} = Astro.props;
const siteTitle = title.endsWith(siteConfig.title) ? title : `${title} · ${siteConfig.title}`;
const fontCss = `:root { --font-family: ${siteConfig.fontFamily}; }`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <Fragment set:html={`<style>${fontCss}</style>`} />
    <script is:inline define:vars={{ defaultTheme: siteConfig.defaultTheme }}>
      (function () {
        try {
          var stored = localStorage.getItem("tsuki-theme");
          var theme = stored === "light" || stored === "dark" ? stored : defaultTheme;
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", defaultTheme);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到主要内容</a>
    <Header />
    <main id="main">
      <div class="container main-gap">
        <slot />
      </div>
    </main>
    {!hideFooter && (
      <footer class="site-footer">
        <svg class="footer-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        {siteConfig.footer}
      </footer>
    )}
  </body>
</html>
